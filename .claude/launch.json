{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gallery",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@polyxd/gallery"
      ],
      "port": 5173
    },
    {
      "name": "studio",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--cwd",
        "apps/studio",
        "--port",
        "8789"
      ],
      "port": 8789
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--cwd",
        "apps/site",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "demos",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@polyxd/demos"
      ],
      "port": 5174
    },
    {
      "name": "vscode-webview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/vscode/scripts/serve-webview.ts",
        "--port",
        "4320"
      ],
      "port": 4320
    }
  ]
}
