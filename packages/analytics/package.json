{
  "name": "@polyxd/analytics",
  "version": "0.4.5",
  "description": "Sends Polyxd's semantic events to your own analytics: PostHog, Segment, Google Analytics 4 or your endpoint, with an allow-list guard. No dependencies; Polyxd receives nothing",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@polyxd/core": "^0.4.5",
    "ajv": "^8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualfart/polyxd.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://polyxd.com",
  "bugs": "https://github.com/visualfart/polyxd/issues",
  "publishConfig": {
    "access": "public"
  }
}
