{
  "$schema": "../spec/schema/design-system.schema.json",
  "name": "spectrum",
  "displayName": "Adobe Spectrum 2",
  "version": "0.0.0",
  "contractVersion": "0.2.0",
  "license": "Apache-2.0",
  "modes": {
    "light": [
      "tokens/system.light.json",
      "tokens/semantic.json"
    ],
    "dark": [
      "tokens/system.dark.json",
      "tokens/semantic.json"
    ]
  },
  "defaultMode": "light",
  "provenance": [
    {
      "source": "npm:@adobe/spectrum-tokens dist/json/variables.json (https://github.com/adobe/spectrum-tokens)",
