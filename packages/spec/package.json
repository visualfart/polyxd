{
  "name": "@polixd/spec",
  "version": "0.1.0",
  "private": true,
  "description": "Polixd spec: JSON Schema and TypeScript types for just-in-time interfaces",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\"",
    "check-ds": "node src/cli/check-design-system.ts",
    "build:schema": "node scripts/build-schema.ts",
    "validate": "node src/cli/validate.ts"
  },
  "files": [
    "dist",
    "schema",
    "catalog",
    "tokens",
    "components",
    "examples",
    "docs"
  ],
  "bin": {
    "polixd-check-ds": "dist/cli/check-design-system.js",
    "polixd-validate": "dist/cli/validate.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "default": "./dist/patterns.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./dist/capabilities.js"
    },
    "./checks": {
      "types": "./dist/checks.d.ts",
      "default": "./dist/checks.js"
    },
    "./schema/*": "./schema/*",
    "./catalog/*": "./catalog/*",
    "./tokens/*": "./tokens/*",
    "./components/*": "./components/*",
    "./patterns/*": "./patterns/*",
    "./package.json": "./package.json"
  }
}
