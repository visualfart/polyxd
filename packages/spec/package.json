{
  "name": "@polyxd/spec",
  "version": "0.3.0",
  "description": "Polyxd spec: JSON Schema and TypeScript types for just-in-time interfaces",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\"",
    "check-ds": "node src/cli/check-design-system.ts",
    "build:schema": "node scripts/build-schema.ts",
    "validate": "node src/cli/validate.ts"
  },
  "files": [
    "dist",
    "schema",
    "catalog",
    "tokens",
    "components",
    "patterns",
    "examples",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "polyxd-check-ds": "dist/cli/check-design-system.js",
    "polyxd-validate": "dist/cli/validate.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "default": "./dist/color.js"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "default": "./dist/patterns.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./dist/capabilities.js"
    },
    "./checks": {
      "types": "./dist/checks.d.ts",
      "default": "./dist/checks.js"
    },
    "./schema/*": "./schema/*",
    "./catalog/*": "./catalog/*",
    "./tokens/*": "./tokens/*",
    "./components/*": "./components/*",
    "./patterns/*": "./patterns/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualfart/polyxd.git",
    "directory": "packages/spec"
  },
  "homepage": "https://polyxd.com",
  "bugs": "https://github.com/visualfart/polyxd/issues",
  "publishConfig": {
    "access": "public"
  }
}
