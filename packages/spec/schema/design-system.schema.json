{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyxd.com/schema/0.1/design-system.schema.json",
  "title": "Polyxd design-system pack manifest",
  "description": "Describes a design-system pack: which DTCG token files make up each mode. Files listed for a mode are merged in order, later files overriding earlier ones.",
  "type": "object",
  "required": ["name", "version", "contractVersion", "license", "modes", "defaultMode"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string" },
    "version": { "type": "string" },
    "contractVersion": { "type": "string", "description": "Version of the semantic token contract this pack satisfies" },
    "license": { "type": "string" },
    "modes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "description": "Path to a DTCG token file, relative to the manifest" }
      }
    },
    "defaultMode": { "type": "string" },
    "provenance": {
      "type": "array",
      "description": "Where the values came from, so packs stay auditable",
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": { "type": "string" },
          "version": { "type": "string" },
          "license": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
