{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polixd.dev/schema/0.1/direction.schema.json",
  "title": "Polixd Design Direction",
  "description": "A company's taste, as a versioned package: profile, voice, pattern preferences, rules and exemplars. Tokens live in the design-system pack it references. Precedence: accessibility floor > user accessibility needs > rules > profile/voice/patterns > user preferences > model defaults.",
  "type": "object",
  "required": ["name", "version", "profile"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string" },
    "designSystem": { "type": "string", "description": "Design-system pack name (e.g. 'material3')" },
    "profile": {
      "type": "object",
      "properties": {
        "density": { "enum": ["compact", "comfortable", "spacious"], "default": "comfortable" },
        "emphasisBudget": { "type": "integer", "minimum": 1, "maximum": 3, "default": 1, "description": "Primary actions allowed per view (the accessibility floor still caps this at 1 for most platforms)" },
        "dataDisplay": { "enum": ["auto", "prefer-charts", "prefer-tables", "prefer-metrics"], "default": "auto" },
        "motion": { "enum": ["none", "subtle", "expressive"], "default": "subtle" },
        "disclosure": { "enum": ["show-everything", "progressive"], "default": "progressive", "description": "How eagerly secondary detail goes behind Disclosure" },
        "freedom": { "enum": ["strict", "guided", "open"], "default": "guided", "description": "strict: approved patterns only; guided: new layouts from approved components; open: anything that passes the verifier" }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "guidelines": { "type": "array", "items": { "type": "string" }, "description": "Plain-language copy guidance given to the generator" },
        "casing": { "enum": ["sentence", "title"], "default": "sentence" },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["use"],
            "properties": { "use": { "type": "string" }, "insteadOf": { "type": "array", "items": { "type": "string" } } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "patterns": {
      "type": "object",
      "properties": {
        "prefer": { "type": "array", "items": { "type": "string" } },
        "disallow": { "type": "array", "items": { "type": "string" } },
        "custom": { "type": "array", "items": { "type": "string" }, "description": "Paths to the company's own pattern files (same format as core patterns); these take precedence" }
      },
      "additionalProperties": false
    },
    "rules": { "type": "array", "items": { "$ref": "check.schema.json#/$defs/Rule" } },
    "exemplars": {
      "type": "array",
      "description": "Approved 'this is how we'd do it' examples, retrieved at generation time",
      "items": {
        "type": "object",
        "required": ["request", "document"],
        "properties": { "request": { "type": "string" }, "document": { "type": "string", "description": "Path to a UI document" } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
