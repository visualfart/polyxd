{
  "$schema": "../schema/ui.schema.json",
  "specVersion": "0.2.0",
  "surface": {
    "id": "move-files",
    "title": "Move 3 files",
    "intent": "files.move"
  },
  "root": "drawer",
  "components": [
    {
      "id": "drawer",
      "component": "Panel",
      "kind": "drawer",
      "title": "Move 3 files",
      "children": [
        "selected",
        "folders",
        "move-note"
      ],
      "actions": "move-actions"
    },
    {
      "id": "selected",
      "component": "Collection",
      "key": "selected_files",
      "label": "Files to move",
      "layout": "list",
      "items": {
        "path": "/selection/files",
        "componentId": "file"
      }
    },
    {
      "id": "file",
      "component": "Card",
      "title": {
        "path": "name"
      },
      "subtitle": {
        "path": "modified"
      },
      "children": [
        "file-kind",
        "file-size"
      ]
    },
    {
      "id": "file-kind",
      "component": "Tag",
      "kind": "label",
      "label": {
        "path": "kind"
      }
    },
    {
      "id": "file-size",
      "component": "Tag",
      "kind": "label",
      "label": {
        "path": "size"
      }
    },
    {
      "id": "folders",
      "component": "Tree",
      "key": "folder",
      "label": "Move to",
      "items": {
        "path": "/folders"
      },
      "labelPath": "name",
      "childrenPath": "folders",
      "valuePath": "id",
      "detailPath": "count",
      "selection": "single",
      "selected": {
        "path": "/draft/folder"
      },
      "expanded": {
        "path": "/draft/expanded"
      }
    },
    {
      "id": "move-note",
      "component": "Text",
      "variant": "supporting",
      "text": "Sharing settings and links stay as they are."
    },
    {
      "id": "move-actions",
      "component": "ActionBar",
      "children": [
        "move",
        "cancel"
      ]
    },
    {
      "id": "move",
      "component": "Action",
      "label": "Move 3 files",
      "emphasis": "primary",
      "action": {
        "event": {
          "name": "files.move",
          "context": {
            "files": {
              "path": "/selection/ids"
            },
            "folder": {
              "path": "/draft/folder"
            }
          }
        }
      }
    },
    {
      "id": "cancel",
      "component": "Action",
      "label": "Cancel",
      "emphasis": "tertiary",
      "action": {
        "event": {
          "name": "ui.dismiss"
        }
      }
    }
  ],
