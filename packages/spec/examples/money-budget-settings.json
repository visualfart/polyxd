{
  "$schema": "../schema/ui.schema.json",
  "specVersion": "0.1.0",
  "surface": {
    "id": "budget",
    "title": "Groceries budget",
    "intent": "money.budget.edit"
  },
  "root": "root",
  "components": [
    {
      "id": "root",
      "component": "Section",
      "title": "Groceries",
      "description": "Set a monthly limit and how we warn you.",
      "children": [
        "cap",
        "alerts",
        "used"
      ]
    },
    {
      "id": "cap",
      "component": "RangeInput",
      "key": "cap",
      "label": "Monthly limit",
      "value": {
        "path": "/budget/cap"
      },
      "min": 0,
      "max": 1000,
      "step": 10,
      "format": {
        "type": "currency",
        "currency": "GBP"
      }
    },
    {
      "id": "alerts",
      "component": "Toggle",
      "key": "alerts",
      "label": "Warn me at 80% of the limit",
      "value": {
        "path": "/budget/alerts"
      },
      "action": {
        "event": {
          "name": "budget.setAlerts",
          "context": {
            "enabled": {
              "path": "/budget/alerts"
            }
          }
        }
      }
    },
    {
      "id": "used",
      "component": "Metric",
      "key": "used",
      "label": "Used so far",
      "value": {
        "path": "/budget/used"
      },
      "format": {
        "type": "currency",
        "currency": "GBP"
      },
      "caption": {
        "path": "/budget/usedCaption"
      }
    }
  ],
  "data": {
    "budget": {
      "cap": 400,
      "alerts": true,
      "used": 212.5,
      "usedCaption": "53% of your limit, 12 days left"
    }
  }
}
