{
  "$schema": "../schema/ui.schema.json",
  "specVersion": "0.2.0",
  "surface": {
    "id": "send-confirm",
    "title": "Confirm payment",
    "intent": "money.send",
    "pattern": "confirm-destructive"
  },
  "root": "confirm",
  "components": [
    {
      "id": "confirm",
      "component": "Confirm",
      "title": "Send this payment?",
      "severity": "consequential",
      "consequence": "The money leaves your account immediately and can't be recalled.",
      "summary": "summary",
      "confirm": {
        "label": "Send £250.00",
        "action": {
          "event": {
            "name": "transfer.confirm",
            "context": {
              "quoteId": {
                "path": "/quote/id"
              }
            }
          }
        }
      },
      "amount": {
        "value": {
          "path": "/quote/amount"
        },
        "format": {
          "type": "currency",
          "currency": "GBP"
        }
      },
      "subject": {
        "title": {
          "path": "/quote/recipient"
        },
        "subtitle": {
          "path": "/quote/recipientAccount"
        },
        "avatar": {
          "path": "/quote/recipientInitials"
        }
      }
    },
    {
      "id": "summary",
      "component": "DetailList",
      "items": [
        {
          "key": "amount",
          "label": "Amount",
          "value": {
            "path": "/quote/amount"
          },
          "format": {
            "type": "currency",
            "currency": "GBP"
          }
        },
        {
          "key": "fee",
          "label": "Fee",
          "value": {
            "path": "/quote/fee"
          },
          "format": {
            "type": "currency",
            "currency": "GBP"
          }
        },
        {
          "key": "reference",
          "label": "Reference",
          "value": {
            "path": "/quote/reference"
          }
        },
        {
          "key": "total",
          "label": "They get",
          "value": {
            "path": "/quote/amount"
          },
          "format": {
            "type": "currency",
            "currency": "GBP"
          },
          "total": true
        }
      ],
      "variant": "receipt"
    }
  ],
  "data": {
    "quote": {
      "id": "q_91",
      "recipient": "Alex Kim",
      "amount": 250,
      "fee": 0,
      "reference": "Rent share",
      "recipientAccount": "Monzo ••42",
      "recipientInitials": "AK"
    }
  }
}
