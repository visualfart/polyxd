{
  "$schema": "../schema/ui.schema.json",
  "specVersion": "0.1.0",
  "surface": {
    "id": "browse",
    "title": "Desk lamps",
    "intent": "commerce.browse",
    "pattern": "filter-and-browse"
  },
  "root": "root",
  "components": [
    {
      "id": "root",
      "component": "FilterPanel",
      "label": "Filter lamps",
      "children": [
        "search",
        "category",
        "price"
      ],
      "results": "results",
      "resultCount": {
        "path": "/resultCount"
      },
      "clear": {
        "event": {
          "name": "filters.clear"
        }
      }
    },
    {
      "id": "search",
      "component": "TextInput",
      "key": "search",
      "label": "Search lamps",
      "kind": "search",
      "value": {
        "path": "/filters/q"
      },
      "placeholder": "Try “warm light” or “brass”"
    },
    {
      "id": "category",
      "component": "Choice",
      "key": "category",
      "label": "Type",
      "mode": "multiple",
      "options": [
        {
          "value": "desk",
          "label": "Desk"
        },
        {
          "value": "floor",
          "label": "Floor"
        },
        {
          "value": "clip",
          "label": "Clip-on"
        }
      ],
      "value": {
        "path": "/filters/types"
      }
    },
    {
      "id": "price",
      "component": "RangeInput",
      "key": "price",
      "label": "Price",
      "value": {
        "path": "/filters/price"
      },
      "min": 0,
      "max": 300,
      "step": 5,
      "format": {
        "type": "currency",
        "currency": "GBP"
      },
      "mode": "range"
    },
    {
      "id": "results",
      "component": "Collection",
      "key": "results",
      "label": {
        "path": "/resultsLabel"
      },
      "items": {
        "path": "/products",
        "componentId": "product"
      },
      "empty": "no-results",
      "layout": "grid"
    },
    {
      "id": "product",
      "component": "Card",
      "title": {
        "path": "name"
      },
      "subtitle": {
        "path": "priceLabel"
      },
      "media": "product-img",
      "action": {
        "event": {
          "name": "product.open",
          "context": {
            "id": {
              "path": "id"
            }
          }
        }
      }
    },
    {
      "id": "product-img",
      "component": "Media",
      "src": {
        "path": "image"
      },
      "decorative": true
    },
    {
      "id": "no-results",
      "component": "Status",
      "kind": "empty",
      "title": "No lamps match",
      "message": "Try a higher price or fewer types."
    }
  ],
  "data": {
    "filters": {
      "q": "",
      "types": [
        "desk"
      ],
      "price": [
        20,
        120
      ]
    },
    "resultsLabel": "Desk lamps",
    "products": [
      {
        "id": "l1",
        "name": "Arc desk lamp",
        "priceLabel": "£49",
        "image": "img1"
      },
      {
        "id": "l2",
        "name": "Mini clamp lamp",
        "priceLabel": "£22",
        "image": "img2"
      },
      {
        "id": "l3",
        "name": "Brass floor lamp",
        "priceLabel": "£119",
        "image": "img3"
      },
      {
        "id": "l4",
        "name": "Clip-on reading light",
        "priceLabel": "£18",
        "image": "img4"
      }
    ],
    "resultCount": 4
  }
}
