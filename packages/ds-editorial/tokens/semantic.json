  "type": {
    "$type": "typography",
    "title": {
      "page": {
        "$value": {
          "fontFamily": "{editorial.font.display}",
          "fontSize": "{editorial.text.title-page}",
          "fontWeight": "{editorial.weight.700}",
          "lineHeight": 1.1,
          "letterSpacing": {
            "value": -0.5,
            "unit": "px"
          }
        }
      },
      "section": {
        "$value": {
          "fontFamily": "{editorial.font.display}",
          "fontSize": "{editorial.text.title-section}",
          "fontWeight": "{editorial.weight.600}",
          "lineHeight": 1.2,
          "letterSpacing": {
            "value": -0.25,
            "unit": "px"
          }
        }
      },
      "item": {
        "$value": {
          "fontFamily": "{editorial.font.display}",
          "fontSize": "{editorial.text.title-item}",
          "fontWeight": "{editorial.weight.600}",
          "lineHeight": 1.3,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          }
        }
      }
    },
    "body": {
      "default": {
        "$value": {
          "fontFamily": "{editorial.font.body}",
          "fontSize": "{editorial.text.body-default}",
          "fontWeight": "{editorial.weight.400}",
          "lineHeight": 1.6,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          }
        }
      },
      "small": {
        "$value": {
          "fontFamily": "{editorial.font.body}",
          "fontSize": "{editorial.text.body-small}",
          "fontWeight": "{editorial.weight.400}",
          "lineHeight": 1.55,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          }
        }
      }
    },
    "label": {
      "default": {
        "$value": {
          "fontFamily": "{editorial.font.label}",
          "fontSize": "{editorial.text.label-default}",
          "fontWeight": "{editorial.weight.500}",
          "lineHeight": 1.4,
          "letterSpacing": {
            "value": 0.6,
            "unit": "px"
          }
        }
      },
      "small": {
        "$value": {
          "fontFamily": "{editorial.font.label}",
          "fontSize": "{editorial.text.label-small}",
          "fontWeight": "{editorial.weight.500}",
          "lineHeight": 1.4,
          "letterSpacing": {
            "value": 0.8,
            "unit": "px"
          }
        }
      }
