          "fontFamily": "{editorial.font.display}",
          "fontSize": "{editorial.text.numeric-display}",
          "fontWeight": "{editorial.weight.600}",
          "lineHeight": 1.1,
          "letterSpacing": {
            "value": -0.5,
            "unit": "px"
          }
        },
        "$extensions": {
          "com.polyxd": {
            "numeric": "tabular"
          }
        }
      }
    }
