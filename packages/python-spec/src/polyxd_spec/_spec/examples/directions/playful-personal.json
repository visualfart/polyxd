{
  "$schema": "../../schema/direction.schema.json",
  "name": "playful-personal",
  "version": "0.1.0",
  "designSystem": "material3",
  "profile": {
    "density": "compact",
    "emphasisBudget": 1,
    "dataDisplay": "prefer-charts",
    "motion": "expressive",
    "disclosure": "show-everything",
    "freedom": "open"
  },
  "voice": {
    "guidelines": [
      "Warm and encouraging, like a friend keeping you on track.",
      "Short labels; celebrate streaks."
    ],
    "tone": {
      "formality": "casual",
      "energy": "upbeat",
      "warmth": "warm",
      "humor": "light"
    },
    "person": "we-and-you",
    "readingLevel": {
      "maxGrade": 6
    },
    "casing": "sentence",
    "spelling": "en-US",
    "punctuation": {
      "exclamation": "allowed",
      "emoji": "allowed"
    },
    "labels": {
      "maxWords": 3,
      "verbFirst": true
    },
    "avoid": [
      "should",
      "failed"
    ],
    "situations": {
      "empty": "Invite the first step warmly.",
      "success": "Celebrate briefly.",
      "error": "Reassure, then say how to fix it."
    }
  },
  "rules": [
    {
      "id": "celebrate-progress",
      "description": "Personal dashboards show progress visually",
      "severity": "warning",
      "rule": {
        "check": "contains",
        "component": "Chart"
      }
    }
  ]
}
