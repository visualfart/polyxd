{
  "name": "@polyxd/server",
  "version": "0.3.0",
  "description": "A generation server for Polyxd: an HTTP API with streaming around @polyxd/runtime, pointed at the model endpoint you choose",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "polyxd-server": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/bin.js",
    "test": "tsc -b && node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@polyxd/runtime": "^0.3.0",
    "@polyxd/spec": "^0.3.0",
    "@polyxd/verifier": "^0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualfart/polyxd.git",
    "directory": "packages/server"
  },
  "homepage": "https://polyxd.com",
  "bugs": "https://github.com/visualfart/polyxd/issues",
  "publishConfig": {
    "access": "public"
  }
}
