  "shadcn": {
    "radius": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 6,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 10,
          "unit": "px"
        }
      },
      "full": {
        "$value": {
          "value": 9999,
          "unit": "px"
        }
      }
    }
  }
