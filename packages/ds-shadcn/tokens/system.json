            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 4,
              "unit": "px"
            },
            "blur": {
              "value": 6,
              "unit": "px"
            },
            "spread": {
              "value": -4,
              "unit": "px"
            },
            "color": "rgba(0, 0, 0, 0.1)"
          }
        ]
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": {
        "$value": [
          0,
          0,
          0.2,
          1
        ]
      },
      "in": {
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      },
      "in-out": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      }
    },
    "duration": {
      "75": {
        "$value": {
          "value": 75,
          "unit": "ms"
        }
      },
      "150": {
        "$value": {
          "value": 150,
          "unit": "ms"
        }
      },
      "200": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "300": {
        "$value": {
          "value": 300,
          "unit": "ms"
        }
      },
      "$type": "duration"
    }
