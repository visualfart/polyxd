{
  "name": "@polyxd/verifier",
  "version": "0.0.0",
  "private": true,
  "description": "Verifies Polyxd UI documents: spec rules, rendered accessibility and layout, consistency across generations, and scripted agent tasks",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "polyxd-verify": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "build:harness": "vite build --config harness/vite.config.ts",
    "verify": "node src/cli.ts",
    "test": "npm run build:harness && node --test \"test/**/*.test.ts\"",
    "verify:examples": "npm run build:harness && node src/cli.ts ../spec/examples/*.json --registry ../spec/examples/registry/capabilities.json --tasks ../../bench/tasks.json -q",
    "verify:packs": "npm run build:harness && node src/cli.ts ../spec/examples/*.json --registry ../spec/examples/registry/capabilities.json --tasks ../../bench/tasks.json --themes material3,carbon,antd,fluent,shadcn,bootstrap,mantine,radix --widths 390,1100 -q",
    "gold": "npm run build:harness && node scripts/gold-agreement.ts",
    "score": "npm run build:harness && node scripts/score-run.ts",
    "leaderboard": "node scripts/leaderboard.ts"
  },
  "devDependencies": {
    "@polyxd/react": "^0.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@polyxd/spec": "^0.1.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0"
  }
}
