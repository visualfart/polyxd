{
 "specVersion": "0.2.0",
 "surface": {
  "id": "send",
  "title": "Send money",
  "intent": "money.send",
  "pattern": "multi-step-form"
 },
 "root": "form",
 "components": [
  {
   "id": "form",
   "component": "Form",
   "children": [
    "recipient",
    "amount",
    "reference",
    "receipt"
   ],
   "submit": {
    "label": "Continue",
    "action": {
     "event": {
      "name": "transfer.review",
      "context": {
       "recipient": {
        "path": "/draft/recipient"
       },
       "amount": {
        "path": "/draft/amount"
       }
      }
     }
    }
   }
  },
  {
   "id": "recipient",
   "component": "Choice",
   "key": "recipient",
   "label": "Who are you sending to?",
   "options": {
    "path": "/payees",
    "valuePath": "id",
    "labelPath": "name",
    "descriptionPath": "handle",
    "avatarPath": "initials",
    "recentPath": "recent"
   },
   "value": {
    "path": "/draft/recipient"
   },
   "required": true
  },
  {
   "id": "amount",
   "component": "TextInput",
   "key": "amount",
   "label": "Amount",
   "kind": "currency",
   "currency": "GBP",
   "size": "hero",
   "value": {
    "path": "/draft/amount"
   },
   "required": true,
   "validation": {
    "min": 0.01,
    "max": 5000,
    "message": "Enter an amount between \u00a30.01 and \u00a35,000"
   }
  },
  {
   "id": "reference",
   "component": "TextInput",
   "key": "reference",
   "label": "Reference",
   "help": "Shown on their statement",
   "value": {
    "path": "/draft/reference"
   },
   "validation": {
    "maxLength": 18
   }
  },
  {
   "id": "receipt",
   "component": "DetailList",
   "variant": "receipt",
   "items": [
    {
     "key": "amount",
     "label": "Amount",
     "value": {
      "path": "/draft/amount"
     },
     "format": {
      "type": "currency",
      "currency": "GBP"
     }
    },
    {
     "key": "fee",
     "label": "Fee",
     "value": {
      "path": "/quote/fee"
     },
     "format": {
      "type": "currency",
      "currency": "GBP"
     }
    },
    {
     "key": "total",
     "label": "They get",
     "value": {
      "path": "/draft/amount"
     },
     "format": {
      "type": "currency",
      "currency": "GBP"
     },
     "total": true
    }
   ]
  }
 ],
