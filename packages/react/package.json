{
  "name": "@polyxd/react",
  "version": "0.4.3",
  "description": "React renderer for Polyxd UI documents: Radix primitives styled by design-system tokens",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./themes/*": "./themes/*",
    "./preview/*": "./preview/*"
  },
  "files": [
    "dist",
    "src/styles.css",
    "themes",
    "preview",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-preview.ts",
    "build:themes": "node scripts/build-themes.ts",
    "test": "tsc -b && node --test \"test/**/*.test.ts\"",
    "build:preview": "node scripts/build-preview.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@polyxd/core": "^0.4.3",
    "@polyxd/spec": "^0.4.3",
    "radix-ui": "^1.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualfart/polyxd.git",
    "directory": "packages/react"
  },
  "homepage": "https://polyxd.com",
  "bugs": "https://github.com/visualfart/polyxd/issues",
  "publishConfig": {
    "access": "public"
  }
}
