{
  "$description": "Wireframe, light mode: the palette (named colours) and the roles that pick from it. Change a palette entry to recolour every role that uses it; point a role at a different entry to change one thing.",
  "wireframe": {
    "palette": {
      "$type": "color",
      "white": {
        "$value": "#ffffff"
      },
      "grey-50": {
        "$value": "#f4f4f4"
      },
      "grey-100": {
        "$value": "#e6e6e6"
      },
      "grey-300": {
        "$value": "#9c9c9c"
      },
      "grey-500": {
        "$value": "#767676"
      },
      "grey-600": {
        "$value": "#5e5e5e"
      },
      "grey-700": {
        "$value": "#474747"
      },
      "grey-800": {
        "$value": "#333333"
      },
      "grey-900": {
        "$value": "#222222"
      },
      "blue": {
        "$value": "#1a5fd6"
      },
      "blue-deep": {
        "$value": "#183f8a"
      },
      "blue-wash": {
        "$value": "#e8f0fc"
      }
    },
    "sys": {
      "$type": "color",
      "surface-default": {
        "$value": "{wireframe.palette.white}",
        "$description": "Main page background"
      },
      "surface-subtle": {
        "$value": "{wireframe.palette.grey-50}",
        "$description": "Grouping background: table headers, wells"
      },
      "surface-raised": {
        "$value": "{wireframe.palette.white}",
        "$description": "Cards and sheets"
      },
      "surface-overlay": {
        "$value": "{wireframe.palette.white}",
        "$description": "Dialogs and popovers"
      },
      "surface-inverse": {
        "$value": "{wireframe.palette.grey-800}",
        "$description": "Snackbars and tooltips"
      },
      "scrim": {
        "$value": "rgba(0, 0, 0, 0.4)"
      },
      "text-default": {
        "$value": "{wireframe.palette.grey-900}"
      },
      "text-muted": {
        "$value": "{wireframe.palette.grey-600}"
      },
      "text-inverse": {
        "$value": "{wireframe.palette.white}"
      },
      "text-link": {
        "$value": "{wireframe.palette.blue}",
        "$description": "Inline links"
      },
      "border-default": {
        "$value": "{wireframe.palette.grey-300}"
      },
      "border-strong": {
        "$value": "{wireframe.palette.grey-500}",
        "$description": "Input outlines (3:1 on the page)"
      },
      "border-focus": {
        "$value": "{wireframe.palette.blue}",
        "$description": "Keyboard focus ring (3:1 on the page)"
      },
      "action-primary-background": {
        "$value": "{wireframe.palette.blue}"
      },
      "action-primary-foreground": {
        "$value": "{wireframe.palette.white}"
      },
      "action-secondary-background": {
        "$value": "{wireframe.palette.white}"
      },
      "action-secondary-foreground": {
        "$value": "{wireframe.palette.grey-900}"
      },
      "action-secondary-border": {
        "$value": "{wireframe.palette.grey-500}"
      },
      "action-danger-background": {
        "$value": "{wireframe.palette.grey-800}"
      },
      "action-danger-foreground": {
        "$value": "{wireframe.palette.white}"
      },
      "selection-background": {
        "$value": "{wireframe.palette.blue-wash}"
      },
      "selection-foreground": {
        "$value": "{wireframe.palette.blue-deep}"
      },
      "status-info-background": {
        "$value": "{wireframe.palette.blue-wash}"
      },
      "status-info-foreground": {
        "$value": "{wireframe.palette.blue-deep}"
      },
      "status-info-emphasis": {
        "$value": "{wireframe.palette.blue}"
      },
      "status-success-background": {
        "$value": "{wireframe.palette.grey-50}"
      },
      "status-success-foreground": {
        "$value": "{wireframe.palette.grey-900}"
      },
      "status-success-emphasis": {
        "$value": "{wireframe.palette.grey-700}"
      },
      "status-warning-background": {
        "$value": "{wireframe.palette.grey-100}"
      },
      "status-warning-foreground": {
        "$value": "{wireframe.palette.grey-900}"
      },
      "status-warning-emphasis": {
        "$value": "{wireframe.palette.grey-500}"
      },
      "status-danger-background": {
        "$value": "{wireframe.palette.grey-100}"
      },
      "status-danger-foreground": {
        "$value": "{wireframe.palette.grey-900}"
      },
      "status-danger-emphasis": {
        "$value": "{wireframe.palette.grey-800}"
      },
      "data-1": {
        "$value": "{wireframe.palette.blue}"
      },
      "data-2": {
        "$value": "{wireframe.palette.grey-900}"
      },
      "data-3": {
        "$value": "{wireframe.palette.grey-700}"
      },
      "data-4": {
        "$value": "{wireframe.palette.grey-600}"
      },
      "data-5": {
        "$value": "{wireframe.palette.grey-500}"
      },
      "data-6": {
        "$value": "{wireframe.palette.blue-deep}"
      },
      "data-positive": {
        "$value": "{wireframe.palette.grey-800}"
      },
      "data-negative": {
        "$value": "{wireframe.palette.blue}"
      },
      "data-neutral": {
        "$value": "{wireframe.palette.grey-500}"
      }
    },
    "shadow": {
      "$type": "shadow",
      "raised": {
        "$value": [
          {
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 0,
              "unit": "px"
            },
            "blur": {
              "value": 0,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            },
            "color": "rgba(0, 0, 0, 0)"
          }
        ]
      },
      "overlay": {
        "$value": [
          {
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 0,
              "unit": "px"
            },
            "blur": {
              "value": 0,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            },
            "color": "rgba(0, 0, 0, 0)"
          }
        ]
      }
    }
  }
}
