        "$value": "#1c1c1c"
      },
      "grey-900": {
        "$value": "#242424"
      },
      "grey-850": {
        "$value": "#2a2a2a"
      },
      "grey-800": {
        "$value": "#303030"
      },
      "grey-600": {
        "$value": "#5a5a5a"
      },
      "grey-400": {
        "$value": "#8c8c8c"
      },
      "grey-300": {
        "$value": "#ababab"
      },
      "grey-200": {
        "$value": "#cfcfcf"
      },
      "grey-100": {
        "$value": "#eaeaea"
      },
      "blue": {
        "$value": "#7fb0ff"
      },
