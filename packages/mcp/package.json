{
  "name": "@polyxd/mcp",
  "version": "0.3.0",
  "description": "MCP server for Polyxd: gives the host's model the spec, checks the UI documents it writes, and shows them as an MCP App in any design-system pack",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "polyxd-mcp": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-view.ts",
    "build:view": "node scripts/build-view.ts",
    "sync": "node scripts/sync.ts",
    "test": "tsc -b && node scripts/build-view.ts && node --test \"test/**/*.test.ts\""
  },
  "files": [
    "dist",
    "!dist/view",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "@polyxd/spec": "^0.3.0",
    "@polyxd/verifier": "^0.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@polyxd/web": "^0.3.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.63.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualfart/polyxd.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://polyxd.com",
  "bugs": "https://github.com/visualfart/polyxd/issues",
  "publishConfig": {
    "access": "public"
  }
}
