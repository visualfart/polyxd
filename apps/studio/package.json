{
  "name": "@polyxd/studio",
  "version": "0.0.1",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "description": "Polyxd Studio: where a design-system team decides what generated screens may look like, and reviews what they actually look like",
  "type": "module",
  "scripts": {
    "dev": "npm run build:app && wrangler dev",
    "build:app": "vite build",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "db:migrate": "wrangler d1 migrations apply studio-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply studio --remote --env production",
    "deploy": "npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@polyxd/analytics": "^0.4.2",
    "@polyxd/ds-kit": "^0.4.2",
    "@polyxd/react": "^0.4.2",
    "@polyxd/spec": "^0.4.2",
    "better-auth": "^1.7.6",
    "hono": "^4.6.0",
    "kysely": "^0.28.17",
    "kysely-d1": "^0.4.0",
    "posthog-js": "1.434.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@polyxd/core": "^0.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ajv": "^8.20.0",
    "vite": "^6.0.0",
    "wrangler": "^4.135.0"
  }
}
