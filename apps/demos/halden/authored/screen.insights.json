{
  "id": "screen.insights",
  "title": "Insights",
  "ask": [],
  "capabilities": [
    "spend.category",
    "spend.compare",
    "subscriptions.open"
  ],
  "data": {
    "insights": "view:insights"
  },
  "sample": {},
  "document": {
    "specVersion": "0.2.0",
    "surface": {
      "id": "insights",
      "title": "Insights",
      "intent": "screen.insights",
      "origin": "authored",
      "presentation": "page"
    },
    "root": "page",
    "components": [
      {
        "id": "page",
        "component": "Group",
        "children": [
          "spent",
          "month",
          "chart",
          "where",
          "every_month"
        ]
      },
      {
        "id": "spent",
        "component": "Metric",
        "key": "spent",
        "label": {
          "path": "/insights/spentLabel"
        },
        "value": {
          "path": "/insights/total"
        },
        "format": {
          "type": "currency",
          "currency": "GBP"
        }
      },
      {
        "id": "month",
        "component": "Choice",
        "key": "month",
        "label": "Month",
        "options": {
          "path": "/insights/months",
          "valuePath": "key",
          "labelPath": "name"
        },
        "value": {
          "path": "/insights/month"
        }
      },
      {
        "id": "chart",
        "component": "Chart",
        "key": "spend_by_month",
        "intent": "comparison",
        "data": {
          "path": "/insights/months"
        },
        "title": "Spend by month",
        "summary": {
          "path": "/insights/chartSummary"
        },
        "x": {
          "path": "label",
          "label": "Month"
        },
        "series": [
          {
            "key": "total",
            "path": "total",
            "label": "Spent",
            "format": {
              "type": "currency",
              "currency": "GBP"
            }
          }
        ]
      },
      {
        "id": "where",
        "component": "Section",
        "key": "where",
        "title": "Where it went",
        "children": [
          "categories",
          "compare_bar"
        ]
      },
      {
        "id": "categories",
        "component": "Table",
        "key": "categories",
        "rows": {
          "path": "/insights/rows"
        },
        "caption": "Spend by category",
        "columns": [
          {
            "key": "name",
            "label": "Category",
            "path": "name",
            "kind": "entity",
            "secondaryPath": "detail"
          },
          {
            "key": "total",
            "label": "Spent",
            "path": "total",
            "kind": "currency",
            "format": {
              "type": "currency",
              "currency": "GBP"
            }
          }
        ],
        "rowAction": {
          "event": {
            "name": "spend.category",
            "context": {
              "category": {
                "path": "category"
              }
            }
          }
        },
        "empty": "no_spend"
      },
      {
        "id": "no_spend",
        "component": "Status",
        "key": "no_spend",
        "kind": "empty",
        "title": "Nothing spent this month",
        "message": "Payments show here by category as they happen."
      },
      {
        "id": "compare_bar",
        "component": "ActionBar",
        "children": [
          "compare"
        ]
      },
      {
        "id": "compare",
        "component": "Action",
        "key": "compare_months",
        "label": "Compare months",
        "emphasis": "secondary",
        "action": {
          "event": {
            "name": "spend.compare"
          }
        }
      },
      {
        "id": "every_month",
        "component": "Section",
        "key": "every_month",
        "title": "Every month",
        "children": [
          "regular",
          "manage_bar"
        ]
      },
      {
        "id": "regular",
        "component": "Group",
        "key": "regular",
        "arrangement": "inline",
        "children": [
          "subscriptions",
          "rent_and_bills"
        ]
      },
      {
        "id": "subscriptions",
        "component": "Metric",
        "key": "subscriptions",
        "label": "Subscriptions",
        "value": {
          "path": "/insights/subscriptions/monthly"
        },
        "format": {
          "type": "currency",
          "currency": "GBP"
        },
        "caption": {
          "path": "/insights/subscriptions/countLabel"
        }
      },
      {
        "id": "rent_and_bills",
        "component": "Metric",
        "key": "rent_and_bills",
        "label": "Rent and bills",
        "value": {
          "path": "/insights/fixed/total"
        },
        "format": {
          "type": "currency",
          "currency": "GBP"
        },
        "caption": {
          "path": "/insights/fixed/countLabel"
        }
      },
      {
        "id": "manage_bar",
        "component": "ActionBar",
        "children": [
          "manage"
        ]
      },
      {
        "id": "manage",
        "component": "Action",
        "key": "manage_subscriptions",
        "label": "Manage subscriptions",
        "emphasis": "secondary",
        "action": {
          "event": {
            "name": "subscriptions.open"
          }
        }
      }
    ],
