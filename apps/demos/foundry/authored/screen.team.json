{
  "id": "screen.team",
  "title": "Team",
  "ask": [],
  "capabilities": [
    "team.invite",
    "member.handover",
    "invite.withdraw"
  ],
  "data": {
    "team": "view:teamPage",
    "roles": "view:roles"
  },
  "sample": {},
  "document": {
    "specVersion": "0.2.0",
    "surface": {
      "id": "team",
      "title": "Team",
      "intent": "screen.team",
      "subtitle": "Who's on the desk, their load against capacity, and who's away.",
      "actions": "page_actions",
      "presentation": "page",
      "origin": "authored"
    },
    "root": "page",
    "components": [
      {
        "id": "page_actions",
        "component": "ActionBar",
        "children": [
          "invite"
        ]
      },
      {
        "id": "invite",
        "component": "Action",
        "key": "invite",
        "label": "Invite",
        "emphasis": "primary",
        "action": {
          "event": {
            "name": "team.invite"
          }
        }
      },
      {
        "id": "page",
        "component": "Group",
        "children": [
          "summary",
          "members",
          "roles"
        ]
      },
      {
        "id": "summary",
        "component": "Text",
        "key": "team_summary",
        "variant": "supporting",
        "text": {
          "path": "/team/summary"
        }
      },
      {
        "id": "members",
        "component": "Collection",
        "key": "members",
        "label": "Members",
        "layout": "list",
        "items": {
          "path": "/team/members",
          "componentId": "member"
        },
        "empty": "members_empty"
      },
      {
        "id": "members_empty",
        "component": "Status",
        "kind": "empty",
        "icon": "inbox",
        "title": "Nobody on the desk",
        "message": "Invite someone and they appear here."
      },
      {
        "id": "member",
        "component": "Group",
        "label": {
          "path": "name"
        },
        "children": [
          "member_identity",
          "member_tags",
          "member_load",
          "member_menu"
        ]
      },
      {
        "id": "member_identity",
        "component": "Identity",
        "kind": "person",
        "name": {
          "path": "name"
        },
        "detail": {
          "path": "detail"
        }
      },
      {
        "id": "member_tags",
        "component": "Group",
        "arrangement": "inline",
        "children": [
          "member_role",
          "member_active",
          "member_away",
          "member_invited",
          "member_owned"
        ]
      },
      {
        "id": "member_role",
        "component": "Tag",
        "kind": "label",
        "label": {
          "path": "role"
        }
      },
      {
        "id": "member_active",
        "component": "Tag",
        "kind": "status",
        "tone": "success",
        "label": "Active",
        "visible": {
          "path": "active"
        }
      },
      {
        "id": "member_away",
        "component": "Tag",
        "kind": "status",
        "tone": "warning",
        "label": {
          "path": "awayLabel"
        },
        "visible": {
          "path": "away"
        }
      },
      {
        "id": "member_invited",
        "component": "Tag",
        "kind": "status",
        "tone": "info",
        "label": {
          "path": "invitedLabel"
        },
        "visible": {
          "path": "invited"
        }
      },
      {
        "id": "member_owned",
        "component": "Tag",
        "kind": "label",
        "label": {
          "path": "ownedText"
        },
        "visible": {
          "path": "hasOwned"
        }
      },
      {
        "id": "member_load",
        "component": "Progress",
        "kind": "meter",
        "label": "Open tickets",
        "value": {
          "path": "open"
        },
        "max": {
          "path": "capacity"
        },
        "format": {
          "type": "number"
        },
        "caption": {
          "path": "loadCaption"
        },
        "thresholds": {
          "warning": 0.8,
          "danger": 1
        },
        "visible": {
          "path": "hasCapacity"
        }
      },
      {
        "id": "member_menu",
        "component": "ActionMenu",
        "kind": "overflow",
        "label": {
          "path": "menuLabel"
        },
        "children": [
          "handover",
          "withdraw"
        ],
        "visible": {
          "path": "hasActions"
        }
      },
      {
        "id": "handover",
        "component": "Action",
        "key": "hand_over",
        "label": "Hand over tickets",
        "visible": {
          "path": "canHandover"
        },
        "action": {
          "event": {
            "name": "member.handover",
            "context": {
              "id": {
                "path": "id"
              }
            }
          }
        }
      },
      {
        "id": "withdraw",
        "component": "Action",
        "key": "withdraw_invite",
        "label": "Withdraw invite",
        "visible": {
          "path": "invited"
        },
        "action": {
          "event": {
            "name": "invite.withdraw",
            "context": {
              "id": {
                "path": "id"
              }
            }
          }
        }
      },
      {
        "id": "roles",
        "component": "Section",
        "title": "Roles",
        "description": "What each role can do on the desk",
        "children": [
          "roles_list"
        ]
      },
      {
        "id": "roles_list",
        "component": "DetailList",
        "key": "roles",
        "items": [
          {
            "key": "viewer",
            "label": "Viewer",
            "value": {
              "path": "/roles/viewer/description"
            }
          },
          {
            "key": "agent",
            "label": "Agent",
            "value": {
              "path": "/roles/agent/description"
            }
          },
          {
            "key": "manager",
            "label": "Manager",
            "value": {
              "path": "/roles/manager/description"
            }
          },
          {
            "key": "admin",
            "label": "Admin",
            "value": {
              "path": "/roles/admin/description"
            }
          }
        ]
      }
    ],
