{
  "id": "tickets.reassign",
  "title": "Hand tickets to someone else",
  "ask": [
    "hand Sam's open tickets to Lena",
    "reassign Sam's tickets",
    "give Marcus's open tickets to Aiko while he's away",
    "who can take over Jonah's queue"
  ],
  "keywords": [
    "reassign",
    "hand",
    "handover",
    "take over"
  ],
  "slots": {
    "from": "\\b(?<from>[A-Z][a-z]+)'s (?:open )?(?:tickets|queue)",
    "to": "\\bto (?<to>[A-Z][a-z]+)\\b"
  },
  "capabilities": [
    "tickets.assign",
    "ticket.open"
  ],
  "data": {
    "handover": "view:handover"
  },
  "sample": {
    "from": "m_sam",
    "to": "m_lena"
  },
  "document": {
    "specVersion": "0.2.0",
    "surface": {
      "id": "tickets-handover",
      "title": "Hand over tickets",
      "intent": "tickets.reassign"
    },
    "root": "page",
    "components": [
      {
        "id": "page",
        "component": "Group",
        "children": [
          "intro",
          "table",
          "assignee",
          "actions"
        ]
      },
      {
        "id": "intro",
        "component": "Text",
        "key": "intro",
        "variant": "supporting",
        "text": {
          "path": "/handover/intro"
        }
      },
      {
        "id": "table",
        "component": "Table",
        "key": "tickets",
        "rows": {
          "path": "/handover/tickets"
        },
        "caption": {
          "path": "/handover/caption"
        },
        "rowValuePath": "id",
        "selection": "multiple",
        "selected": {
          "path": "/handover/selection/ids"
        },
        "columns": [
          {
            "key": "subject",
            "label": "Ticket",
            "path": "subject",
            "kind": "entity",
            "secondaryPath": "account"
          },
          {
            "key": "priority",
            "label": "Priority",
            "path": "priority",
            "kind": "status",
            "tones": {
              "Urgent": "danger",
              "High": "warning",
              "Normal": "neutral",
              "Low": "neutral"
            }
          },
          {
            "key": "status",
            "label": "Status",
            "path": "status",
            "kind": "status",
            "tones": {
              "Open": "info",
              "Pending": "warning"
            }
          },
          {
            "key": "sla",
            "label": "First response",
            "path": "sla"
          },
          {
            "key": "updated",
            "label": "Updated",
            "path": "updatedAt",
            "kind": "date",
            "format": {
              "type": "relativeTime"
            }
          }
        ],
        "rowAction": {
          "event": {
            "name": "ticket.open",
            "context": {
              "id": {
                "path": "id"
              }
            }
          }
        },
        "empty": "empty"
      },
      {
        "id": "empty",
        "component": "Status",
        "kind": "empty",
        "icon": "inbox",
        "title": "Nothing to hand over",
        "message": "No open or pending tickets are assigned to them."
      },
      {
        "id": "assignee",
        "component": "Choice",
        "key": "assignee",
        "label": "Hand them to",
        "options": {
          "path": "/handover/team",
          "valuePath": "id",
          "labelPath": "name",
          "descriptionPath": "detail",
          "avatarPath": "initials"
        },
        "value": {
          "path": "/handover/selection/assigneeId"
        },
        "required": true,
        "help": "Their open tickets and capacity are shown so the load stays fair."
      },
      {
        "id": "actions",
        "component": "ActionBar",
        "children": [
          "assign"
        ]
      },
      {
        "id": "assign",
        "component": "Action",
        "key": "assign",
        "label": "Reassign selected tickets",
        "emphasis": "primary",
        "action": {
          "event": {
            "name": "tickets.assign",
            "context": {
              "ticketIds": {
                "path": "/handover/selection/ids"
              },
              "assigneeId": {
                "path": "/handover/selection/assigneeId"
              }
            }
          }
        }
      }
    ],
