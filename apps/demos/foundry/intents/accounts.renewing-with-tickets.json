          {
            "value": "starter",
            "label": "Starter"
          },
          {
            "value": "growth",
            "label": "Growth"
          },
          {
            "value": "scale",
            "label": "Scale"
          }
        ],
        "value": {
          "path": "/filters/plans"
        }
      },
      {
        "id": "table",
        "component": "Table",
