{
  "id": "accounts.renewing-with-tickets",
  "title": "Accounts renewing soon with open tickets",
  "ask": [
    "accounts renewing in 30 days with open tickets",
    "who's renewing in the next 60 days with open tickets",
    "at risk accounts renewing this quarter",
    "renewals with open tickets"
  ],
  "keywords": [
    "renewing"
  ],
  "slots": {
    "days": "\\b(?<days>30|60|90|quarter|month)\\b",
    "health": "\\b(?<health>at risk|healthy|watch)\\b",
    "plan": "\\bon (?<plan>starter|growth|scale)\\b"
  },
  "capabilities": [
    "account.open"
  ],
  "pattern": "filter-and-browse",
  "data": {
    "filters": "view:renewingFilters",
    "results": "view:renewingResults"
  },
  "sample": {
    "days": 60
  },
