        },
        "caption": {
          "path": "/results/caption"
        },
        "rowValuePath": "id",
        "columns": [
          {
            "key": "name",
            "label": "Account",
            "path": "name",
            "kind": "entity",
            "avatarPath": "initials",
            "secondaryPath": "planLine"
          },
          {
            "key": "health",
            "label": "Health",
            "path": "health",
            "kind": "status",
            "tones": {
              "Healthy": "success",
              "Watch": "warning",
              "At risk": "danger"
            }
          },
          {
            "key": "renews",
            "label": "Renews",
            "path": "renewalAt",
            "kind": "date",
            "format": {
              "type": "date"
            }
          },
          {
            "key": "tickets",
            "label": "Open tickets",
            "path": "openTickets",
            "kind": "number",
            "format": {
              "type": "number"
            }
          },
          {
            "key": "arr",
            "label": "ARR",
            "path": "arr",
            "kind": "currency",
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          }
        ],
        "rowAction": {
          "event": {
            "name": "account.open",
            "context": {
              "id": {
                "path": "id"
              }
            }
          }
        },
        "empty": "empty"
      },
      {
        "id": "empty",
        "component": "Status",
        "kind": "empty",
        "icon": "search",
        "title": "No accounts match",
        "message": "Widen the window or clear a filter. Accounts with no open tickets never show here."
      }
    ],
