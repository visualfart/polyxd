{
  "id": "subscription.cancel",
  "title": "Cancel a customer's plan",
  "ask": [
    "cancel Ledgerline's plan with a prorated refund",
    "cancel a customer's plan",
    "Marrowbank wants to cancel",
    "end Quillpay's subscription and refund the rest"
  ],
  "keywords": [
    "cancel",
    "cancellation"
  ],
  "slots": {
    "account": "(?:cancel |end |for )?(?<account>[A-Z][A-Za-z0-9&' ]+?)(?:'s\\b| wants| plan| subscription|$)",
    "refund": "(?<refund>prorated refund|pro-rated refund|account credit|as credit|no refund)"
  },
  "capabilities": [
    "cancellation.review"
  ],
  "pattern": "multi-step-form",
  "data": {
    "accounts": "view:accountOptions",
    "draft": "view:cancelDraft"
  },
  "fill": {
    "account": "/draft/accountId",
    "refund": "/draft/refundMethod"
  },
  "sample": {
    "account": "acc_0001",
    "refund": "original"
  },
  "document": {
    "specVersion": "0.2.0",
    "surface": {
      "id": "cancel-plan",
      "title": "Cancel a plan",
      "intent": "subscription.cancel",
      "pattern": "multi-step-form"
    },
    "root": "form",
    "components": [
      {
        "id": "form",
        "component": "Form",
        "children": [
          "account",
          "effective",
          "refund",
          "note"
        ],
        "submit": {
          "label": "Review cancellation",
          "action": {
            "event": {
              "name": "cancellation.review",
              "context": {
                "accountId": {
                  "path": "/draft/accountId"
                },
                "effectiveAt": {
                  "path": "/draft/effectiveAt"
                },
                "refundMethod": {
                  "path": "/draft/refundMethod"
                }
              }
            }
          }
        },
        "cancel": {
          "label": "Close",
          "action": {
            "event": {
              "name": "ui.dismiss"
            }
          }
        }
      },
      {
        "id": "account",
        "component": "Choice",
        "key": "account",
        "label": "Customer",
        "options": {
          "path": "/accounts",
          "valuePath": "id",
          "labelPath": "name",
          "descriptionPath": "detail",
          "avatarPath": "initials"
        },
        "value": {
          "path": "/draft/accountId"
        },
        "required": true,
        "help": "Customers on an active plan, by name."
      },
      {
        "id": "effective",
        "component": "DateInput",
        "key": "effective_date",
        "label": "Effective date",
        "kind": "date",
        "value": {
          "path": "/draft/effectiveAt"
        },
        "required": true,
        "help": "Access ends at the end of that day. Today at the earliest."
      },
      {
        "id": "refund",
        "component": "Choice",
        "key": "refund_method",
        "label": "Refund",
        "options": [
          {
            "value": "original",
            "label": "Original payment method",
            "description": "The unused months go back to the card or account on file"
          },
          {
            "value": "credit",
            "label": "Account credit",
            "description": "Held against a future plan with Basalt"
          },
          {
            "value": "none",
            "label": "No refund",
            "description": "The unused months are forfeited"
          }
        ],
        "value": {
          "path": "/draft/refundMethod"
        },
        "required": true
      },
      {
        "id": "note",
        "component": "Text",
        "key": "proration_note",
        "variant": "supporting",
        "text": "The refund is worked out pro rata from the unused whole months of the annual term. You see the exact amount, and what ends, before anything is canceled."
      }
    ],
