{
  "id": "orders.late",
  "title": "Orders that should have shipped",
  "ask": [
    "which orders are stuck",
    "orders that should have shipped by now",
    "what hasn't shipped yet",
    "show me late orders"
  ],
  "keywords": [
    "stuck",
    "late",
    "overdue",
    "shipped"
  ],
  "capabilities": [
    "order.open",
    "fulfillment.review"
  ],
  "data": {
    "late": "view:late"
  },
  "sample": {},
  "document": {
    "specVersion": "0.2.0",
    "surface": {
      "id": "orders-late",
      "title": "Past their ship date",
      "intent": "orders.late"
    },
    "root": "page",
    "components": [
      {
        "id": "page",
        "component": "Group",
        "children": [
          "intro",
          "table",
          "actions"
        ]
      },
      {
        "id": "intro",
        "component": "Text",
        "key": "intro",
        "variant": "supporting",
        "text": {
          "path": "/late/intro"
        }
      },
      {
        "id": "table",
        "component": "Table",
        "key": "late_orders",
        "rows": {
          "path": "/late/rows"
        },
        "caption": {
          "path": "/late/caption"
        },
        "rowValuePath": "id",
        "selection": "multiple",
        "selected": {
          "path": "/late/selection/ids"
        },
        "columns": [
          {
            "key": "order",
            "label": "Order",
            "path": "number",
            "kind": "entity",
            "avatarPath": "initials",
            "secondaryPath": "customer"
          },
          {
            "key": "promised",
            "label": "Promised by",
            "path": "promised",
            "kind": "date",
            "format": {
              "type": "relativeTime"
            }
          },
          {
            "key": "items",
            "label": "Items",
            "path": "items",
            "kind": "number",
            "format": {
              "type": "number"
            }
          },
          {
            "key": "payment",
            "label": "Payment",
            "path": "payment",
            "kind": "status",
            "tones": {
              "Paid": "success",
              "Pending": "warning",
              "Partially refunded": "warning",
              "Refunded": "neutral"
            }
          },
          {
            "key": "total",
            "label": "Total",
            "path": "total",
            "kind": "currency",
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          }
        ],
        "rowAction": {
          "event": {
            "name": "order.open",
            "context": {
              "id": {
                "path": "id"
              }
            }
          }
        },
        "empty": "empty"
      },
      {
        "id": "empty",
        "component": "Status",
        "kind": "empty",
        "icon": "check",
        "title": "Nothing is late",
        "message": "Every unfulfilled order is still inside its two-business-day promise. New orders land in Orders › Unfulfilled."
      },
      {
        "id": "actions",
        "component": "ActionBar",
        "children": [
          "review"
        ]
      },
      {
        "id": "review",
        "component": "Action",
        "key": "review",
        "label": "Fulfill selected",
        "emphasis": "primary",
        "action": {
          "event": {
            "name": "fulfillment.review",
            "context": {
              "orderIds": {
                "path": "/late/selection/ids"
              }
            }
          }
        }
      }
    ],
