{
  "id": "checkouts.recover",
  "title": "Remind people who left a checkout",
  "ask": [
    "send reminders for abandoned checkouts",
    "remind people who left a cart this week",
    "recover abandoned carts",
    "email people who didn't finish checking out"
  ],
  "keywords": [
    "abandoned",
    "cart",
    "carts",
    "reminder",
    "reminders",
    "recover"
  ],
  "capabilities": [
    "recovery.review"
  ],
  "data": {
    "recover": "view:recover"
  },
  "sample": {},
  "document": {
    "specVersion": "0.2.0",
    "surface": {
      "id": "checkouts-recover",
      "title": "Abandoned checkouts this week",
      "intent": "checkouts.recover"
    },
    "root": "page",
    "components": [
      {
        "id": "page",
        "component": "Group",
        "children": [
          "intro",
          "table",
          "discount",
          "actions"
        ]
      },
      {
        "id": "intro",
        "component": "Text",
        "key": "intro",
        "variant": "supporting",
        "text": {
          "path": "/recover/intro"
        }
      },
      {
        "id": "table",
        "component": "Table",
        "key": "checkouts",
        "rows": {
          "path": "/recover/rows"
        },
        "caption": {
          "path": "/recover/caption"
        },
        "rowValuePath": "id",
        "selection": "multiple",
        "selected": {
          "path": "/recover/selection/ids"
        },
        "columns": [
          {
            "key": "customer",
            "label": "Customer",
            "path": "name",
            "kind": "entity",
            "avatarPath": "initials",
            "secondaryPath": "email"
          },
          {
            "key": "left",
            "label": "Left",
            "path": "left",
            "kind": "date",
            "format": {
              "type": "relativeTime"
            }
          },
          {
            "key": "items",
            "label": "In the cart",
            "path": "itemsText"
          },
          {
            "key": "value",
            "label": "Value",
            "path": "value",
            "kind": "currency",
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          },
          {
            "key": "email",
            "label": "Reminder",
            "path": "emailStatus",
            "kind": "status",
            "tones": {
              "Not sent": "warning",
              "Sent": "info",
              "Opened": "success",
              "Recovered": "success"
            }
          }
        ],
        "empty": "empty"
      },
      {
        "id": "empty",
        "component": "Status",
        "kind": "empty",
        "icon": "inbox",
        "title": "No checkouts were left this week",
        "message": "A checkout lands here when someone enters their email and doesn't pay. Older ones are under Orders › Abandoned checkouts."
      },
      {
        "id": "discount",
        "component": "Choice",
        "key": "discount",
        "label": "Discount to include",
        "options": {
          "path": "/recover/discounts",
          "valuePath": "id",
          "labelPath": "name",
          "descriptionPath": "detail"
        },
        "value": {
          "path": "/recover/selection/discountId"
        },
        "required": true,
        "help": "Only active codes are listed. A reminder with no discount still converts about one in ten."
      },
      {
        "id": "actions",
        "component": "ActionBar",
        "children": [
          "review"
        ]
      },
      {
        "id": "review",
        "component": "Action",
        "key": "review",
        "label": "Review reminders",
        "emphasis": "primary",
        "action": {
          "event": {
            "name": "recovery.review",
            "context": {
              "checkoutIds": {
                "path": "/recover/selection/ids"
              },
              "discountId": {
                "path": "/recover/selection/discountId"
              }
            }
          }
        }
      }
    ],
