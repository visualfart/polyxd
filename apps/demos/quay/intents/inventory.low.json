            "perWeek": 0.93,
            "days": 30,
            "status": "Under a month"
          },
          {
            "id": "var_0097",
            "productId": "prd_0045",
            "name": "Wick Trimmer",
            "initials": "WT",
            "line": "Black · LW-A-01-BL",
            "type": "Accessory",
            "inventory": 2,
