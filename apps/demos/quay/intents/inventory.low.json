            "line": "8 oz · LW-C-LAFI-08",
            "type": "Candle",
            "inventory": 3,
            "perWeek": 0.7,
            "days": 30,
            "status": "Under a month"
          },
          {
            "id": "var_0043",
            "productId": "prd_0015",
            "name": "Amber & Oak Reed Diffuser",
            "initials": "AO",
            "line": "100 ml · LW-D-AMOA-100",
            "type": "Diffuser",
