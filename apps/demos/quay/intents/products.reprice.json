{
  "id": "products.reprice",
  "title": "Change prices by a percentage",
  "ask": [
    "raise prices 5% on candles",
    "increase candle prices by 5%",
    "lower diffuser prices by 10%",
    "change prices across a product type"
  ],
  "keywords": [
    "prices",
    "reprice",
    "pricing"
  ],
  "slots": {
    "percent": "\\b(?<percent>\\d+(?:\\.\\d+)?)\\s?%",
    "type": "\\b(?<type>candles?|diffusers?|wax melts?|melts?|gift sets?|accessor(?:y|ies))\\b",
    "direction": "\\b(?<direction>raise|increase|lift|lower|cut|reduce|drop|decrease)\\b"
  },
  "capabilities": [
    "pricing.review"
  ],
  "data": {
    "reprice": "view:repriceDraft",
    "types": "view:repriceTypes",
    "preview": "view:repricePreview"
  },
  "sample": {
    "percent": 5,
    "type": "candle"
  },
  "document": {
    "specVersion": "0.2.0",
    "surface": {
      "id": "products-reprice",
      "title": "Change prices",
      "intent": "products.reprice"
    },
    "root": "page",
    "components": [
      {
        "id": "page",
        "component": "Group",
        "children": [
          "inputs",
          "summary",
          "table",
          "actions"
        ]
      },
      {
        "id": "inputs",
        "component": "Group",
        "arrangement": "inline",
        "label": "What changes",
        "children": [
          "percent",
          "type"
        ]
      },
      {
        "id": "percent",
        "component": "TextInput",
        "key": "percent",
        "label": "Change, percent",
        "kind": "number",
        "value": {
          "path": "/reprice/percent"
        },
        "required": true,
        "validation": {
          "min": -50,
          "max": 100,
          "message": "Between -50 and 100"
        },
        "help": "A negative number lowers prices."
      },
      {
        "id": "type",
        "component": "Choice",
        "key": "type",
        "label": "Products",
        "options": {
          "path": "/types",
          "valuePath": "id",
          "labelPath": "name"
        },
        "value": {
          "path": "/reprice/type"
        },
        "required": true
      },
      {
        "id": "summary",
        "component": "Text",
        "key": "summary",
        "variant": "supporting",
        "text": {
          "path": "/preview/summaryText"
        }
      },
      {
        "id": "table",
        "component": "Table",
        "key": "preview",
        "rows": {
          "path": "/preview/rows"
        },
        "caption": {
          "path": "/preview/caption"
        },
        "rowValuePath": "id",
        "columns": [
          {
            "key": "name",
            "label": "Variant",
            "path": "name",
            "kind": "entity",
            "avatarPath": "initials",
            "secondaryPath": "line"
          },
          {
            "key": "before",
            "label": "Now",
            "path": "before",
            "kind": "currency",
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          },
          {
            "key": "after",
            "label": "After",
            "path": "after",
            "kind": "currency",
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          },
          {
            "key": "delta",
            "label": "Change",
            "path": "delta",
            "kind": "currency",
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          }
        ],
        "empty": "empty"
      },
      {
        "id": "empty",
        "component": "Status",
        "kind": "empty",
        "icon": "tag",
        "title": "No products of that type",
        "message": "Pick another type, or All products."
      },
      {
        "id": "actions",
        "component": "ActionBar",
        "children": [
          "review"
        ]
      },
      {
        "id": "review",
        "component": "Action",
        "key": "review",
        "label": "Review price change",
        "emphasis": "primary",
        "action": {
          "event": {
            "name": "pricing.review",
            "context": {
              "percent": {
                "path": "/reprice/percent"
              },
              "type": {
                "path": "/reprice/type"
              }
            }
          }
        }
      }
    ],
