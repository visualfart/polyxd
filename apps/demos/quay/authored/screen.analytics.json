        },
        "caption": {
          "path": "/analytics/topCaption"
        },
        "rowValuePath": "id",
        "columns": [
          {
            "key": "product",
            "label": "Product",
            "path": "name",
            "kind": "entity",
            "avatarPath": "media",
            "secondaryPath": "type"
          },
          {
            "key": "units",
            "label": "Units",
            "path": "units",
            "kind": "number",
            "format": {
              "type": "number"
            },
            "sortable": true
          },
          {
            "key": "sales",
            "label": "Sales",
            "path": "sales",
            "kind": "currency",
            "format": {
              "type": "currency",
              "currency": "USD"
            },
            "sortable": true
          },
          {
            "key": "share",
            "label": "Share",
            "path": "share",
            "kind": "number",
            "format": {
              "type": "percent",
              "precision": 0
            }
          }
        ],
        "rowAction": {
          "event": {
            "name": "product.open",
            "context": {
              "id": {
                "path": "id"
              }
            }
          }
        },
        "empty": "top_empty"
