              "path": "/analytics/breakdown/net"
            },
            "format": {
              "type": "currency",
              "currency": "USD"
            },
            "total": true
          }
        ]
      },
      {
        "id": "types_section",
        "component": "Section",
        "title": "Sales by product type",
        "children": [
          "types_table"
        ]
      },
      {
        "id": "types_table",
        "component": "Table",
        "key": "sales_by_type",
