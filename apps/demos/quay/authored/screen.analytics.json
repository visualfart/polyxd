              "type": "currency",
              "currency": "USD"
            }
          },
          {
            "key": "discounts",
            "label": "Discounts",
            "value": {
              "path": "/analytics/breakdown/discounts"
            },
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          },
          {
            "key": "returns",
            "label": "Returns",
            "value": {
              "path": "/analytics/breakdown/returns"
            },
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          },
          {
            "key": "shipping",
