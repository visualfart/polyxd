        "caption": "Sales by product type, most first",
        "rowValuePath": "type",
        "columns": [
          {
            "key": "type",
            "label": "Type",
            "path": "name",
            "kind": "text"
          },
          {
            "key": "sales",
            "label": "Sales",
            "path": "sales",
            "kind": "currency",
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          }
        ],
        "rowAction": {
