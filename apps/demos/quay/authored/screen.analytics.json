{
  "id": "screen.analytics",
  "title": "Analytics",
  "ask": [],
  "capabilities": [
    "analytics.range",
    "product.open",
    "products.open",
    "report.export"
  ],
  "data": {
    "analytics": "view:analyticsScreen"
  },
  "sample": {},
  "document": {
    "specVersion": "0.2.0",
    "surface": {
      "id": "analytics",
      "title": "Analytics",
      "intent": "screen.analytics",
      "subtitle": {
        "path": "/analytics/subtitle"
      },
      "actions": "page_actions",
      "presentation": "page",
      "origin": "authored"
    },
    "root": "page",
    "components": [
      {
        "id": "page_actions",
        "component": "ActionBar",
        "children": [
          "export"
        ]
      },
      {
        "id": "export",
        "component": "Action",
        "key": "export",
        "label": "Export",
        "emphasis": "secondary",
        "action": {
          "event": {
            "name": "report.export",
            "context": {
              "report": "analytics",
              "range": {
                "path": "/analytics/range"
              }
            }
          }
        }
      },
      {
        "id": "page",
        "component": "Group",
        "children": [
          "range",
          "figures",
          "over_time",
          "body"
        ]
      },
      {
        "id": "range",
        "component": "Choice",
        "key": "range",
        "label": "Date range",
        "options": [
          {
            "value": "today",
            "label": "Today"
          },
          {
            "value": "7",
            "label": "Last 7 days"
          },
          {
            "value": "30",
            "label": "Last 30 days"
          },
          {
            "value": "90",
            "label": "Last 90 days"
          }
        ],
        "value": {
          "path": "/analytics/range"
        },
        "required": true
      },
      {
        "id": "figures",
        "component": "Group",
        "label": "Figures for the range",
        "children": [
          "figures_sales",
          "figures_rates"
        ]
      },
      {
        "id": "figures_sales",
        "component": "Group",
        "arrangement": "inline",
        "children": [
          "sales",
          "orders",
          "sessions"
        ]
      },
      {
        "id": "figures_rates",
        "component": "Group",
        "arrangement": "inline",
        "children": [
          "conversion",
          "aov",
          "returning"
        ]
      },
      {
        "id": "sales",
        "component": "Metric",
        "key": "total_sales",
        "label": "Total sales",
        "value": {
          "path": "/analytics/sales"
        },
        "format": {
          "type": "currency",
          "currency": "USD"
        },
        "change": {
          "value": {
            "path": "/analytics/salesChange"
          },
          "format": {
            "type": "percent",
            "precision": 0
          },
          "favorable": "increase"
        },
        "caption": {
          "path": "/analytics/compareCaption"
        }
      },
      {
        "id": "orders",
        "component": "Metric",
        "key": "total_orders",
        "label": "Total orders",
        "value": {
          "path": "/analytics/orders"
        },
        "format": {
          "type": "number"
        },
        "change": {
          "value": {
            "path": "/analytics/ordersChange"
          },
          "format": {
            "type": "percent",
            "precision": 0
          },
          "favorable": "increase"
        },
        "caption": {
          "path": "/analytics/compareCaption"
        }
      },
      {
        "id": "sessions",
        "component": "Metric",
        "key": "sessions",
        "label": "Sessions",
        "value": {
          "path": "/analytics/sessions"
        },
        "format": {
          "type": "number"
        },
        "change": {
          "value": {
            "path": "/analytics/sessionsChange"
          },
          "format": {
            "type": "percent",
            "precision": 0
          },
          "favorable": "increase"
        },
        "caption": {
          "path": "/analytics/compareCaption"
        }
      },
      {
        "id": "conversion",
        "component": "Metric",
        "key": "conversion_rate",
        "label": "Conversion rate",
        "value": {
          "path": "/analytics/conversion"
        },
        "format": {
          "type": "percent",
          "precision": 2
        },
        "change": {
          "value": {
            "path": "/analytics/conversionChange"
          },
          "format": {
            "type": "percent",
            "precision": 0
          },
          "favorable": "increase"
        },
        "caption": {
          "path": "/analytics/compareCaption"
        }
      },
      {
        "id": "aov",
        "component": "Metric",
        "key": "average_order_value",
        "label": "Average order value",
        "value": {
          "path": "/analytics/aov"
        },
        "format": {
          "type": "currency",
          "currency": "USD"
        },
        "change": {
          "value": {
            "path": "/analytics/aovChange"
          },
          "format": {
            "type": "percent",
            "precision": 0
          },
          "favorable": "increase"
        },
        "caption": {
          "path": "/analytics/compareCaption"
        }
      },
      {
        "id": "returning",
        "component": "Metric",
        "key": "returning_customer_rate",
        "label": "Returning customer rate",
        "value": {
          "path": "/analytics/returningRate"
        },
        "format": {
          "type": "percent",
          "precision": 1
        },
        "change": {
          "value": {
            "path": "/analytics/returningChange"
          },
          "format": {
            "type": "percent",
            "precision": 0
          },
          "favorable": "increase"
        },
        "caption": {
          "path": "/analytics/compareCaption"
        }
      },
      {
        "id": "over_time",
        "component": "Section",
        "title": "Total sales over time",
        "children": [
          "chart"
        ]
      },
      {
        "id": "chart",
        "component": "Chart",
        "key": "sales_over_time",
        "intent": "trend",
        "data": {
          "path": "/analytics/series"
        },
        "title": {
          "path": "/analytics/chartTitle"
        },
        "summary": {
          "path": "/analytics/chartSummary"
        },
        "x": {
          "path": "date",
          "label": "Day"
        },
        "series": [
          {
            "key": "sales",
            "path": "revenue",
            "label": {
              "path": "/analytics/periodLabel"
            },
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          },
          {
            "key": "previous",
            "path": "previous",
            "label": {
              "path": "/analytics/previousLabel"
            },
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          }
        ]
      },
      {
        "id": "body",
        "component": "Group",
        "children": [
          "main",
          "side"
        ]
      },
      {
        "id": "main",
        "component": "Group",
        "children": [
          "top_section"
        ]
      },
      {
        "id": "top_section",
        "component": "Section",
        "title": "Top products by sales",
        "children": [
          "top_table"
        ]
      },
