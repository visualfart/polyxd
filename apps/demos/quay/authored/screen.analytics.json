            "value": {
              "path": "/analytics/breakdown/shipping"
            },
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          },
          {
            "key": "taxes",
            "label": "Taxes",
            "value": {
              "path": "/analytics/breakdown/taxes"
            },
            "format": {
              "type": "currency",
              "currency": "USD"
            }
          },
          {
            "key": "net_sales",
            "label": "Net sales",
