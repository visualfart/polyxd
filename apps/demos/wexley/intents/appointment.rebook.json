{
  "id": "appointment.rebook",
  "title": "Rebook a repair visit",
  "ask": [
    "change my repair appointment",
    "rebook the plumber",
    "I can't make the repair appointment",
    "move the repair visit to another day"
  ],
  "keywords": [
    "rebook",
    "appointment",
    "reschedule"
  ],
  "capabilities": [
    "appointment.rebook"
  ],
  "pattern": "multi-step-form",
