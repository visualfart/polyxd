  "sample": {},
  "document": {
    "specVersion": "0.2.0",
    "surface": {
      "id": "appointment-rebook",
      "title": "Rebook the repair visit",
      "intent": "appointment.rebook",
      "pattern": "multi-step-form"
    },
    "root": "form",
    "components": [
      {
        "id": "form",
        "component": "Form",
        "key": "rebook_form",
        "children": [
          "current",
          "date",
          "slot",
          "note"
        ],
        "submit": {
          "label": "Rebook the visit",
          "action": {
            "event": {
              "name": "appointment.rebook",
              "context": {
                "repairId": {
                  "path": "/rebook/repairId"
                },
                "date": {
                  "path": "/rebook/date"
                },
                "slot": {
                  "path": "/rebook/slot"
                }
              }
            }
          }
        },
        "cancel": {
          "label": "Keep the current visit",
          "action": {
            "event": {
              "name": "ui.dismiss"
            }
          }
        }
      },
      {
        "id": "current",
        "component": "DetailList",
        "key": "current_visit",
        "items": [
          {
            "key": "repair",
            "label": "Repair",
            "value": {
              "path": "/repair/problem"
            }
          },
          {
            "key": "booked",
            "label": "Booked for",
            "value": {
              "path": "/repair/appointment/line"
            }
          },
          {
            "key": "who",
            "label": "Who is coming",
            "value": {
              "path": "/repair/appointment/who"
            }
          }
        ]
      },
      {
        "id": "date",
        "component": "DateInput",
        "key": "date",
        "label": "New date",
        "help": "A weekday in the next 4 weeks.",
        "value": {
          "path": "/rebook/date"
        },
        "min": {
          "path": "/rebook/minDate"
        },
        "max": {
          "path": "/rebook/maxDate"
        },
        "required": true
      },
      {
        "id": "slot",
        "component": "Choice",
        "key": "slot",
        "label": "Morning or afternoon?",
        "options": [
          {
            "value": "am",
            "label": "Morning, 8am to 1pm"
          },
          {
            "value": "pm",
            "label": "Afternoon, 1pm to 6pm"
          }
        ],
        "value": {
          "path": "/rebook/slot"
        },
        "required": true
      },
      {
        "id": "note",
        "component": "Text",
        "key": "rebook_note",
        "variant": "supporting",
        "text": "The change takes effect straight away and you can undo it. Someone over 18 needs to be at home for the visit."
      }
    ],
