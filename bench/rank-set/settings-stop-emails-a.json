{
  "specVersion": "0.1.0",
  "surface": {
    "id": "settings_notifications",
    "title": "Notification preferences",
    "intent": "settings.notifications"
  },
  "root": {
    "component": "Section",
    "title": "Notification preferences",
    "description": "Manage how you receive alerts.",
    "children": [
      {
        "component": "Toggle",
        "key": "email_notifications",
        "label": "Email",
        "value": {
          "path": "/prefs/email"
        },
        "description": "Turn off email alerts",
        "action": {
          "event": {
            "name": "prefs.set",
            "context": {
              "email": false
            }
          }
        }
      },
      {
        "component": "Toggle",
        "key": "push_notifications",
        "label": "Push",
        "value": {
          "path": "/prefs/push"
        },
        "description": "Turn off push alerts",
        "action": {
          "event": {
            "name": "prefs.set",
            "context": {
              "push": false
            }
          }
        }
      }
    ]
  },
  "data": {
    "prefs": {
      "push": true,
      "email": true,
      "sms": false
    }
  }
}
