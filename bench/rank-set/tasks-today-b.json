{
  "specVersion": "0.1.0",
  "surface": {
    "id": "tasks_today",
    "title": "My tasks today",
    "intent": "tasks.today"
  },
  "root": {
    "component": "Collection",
    "items": {
      "path": "/tasks/{id:task_id}",
      "item": {
        "component": "Card",
        "title": {
          "path": "/title"
        },
        "subtitle": {
          "path": "/project"
        },
        "children": [
          {
            "component": "Text",
            "text": "Priority: {priority}",
            "format": {
              "type": "text"
            }
          }
        ],
        "action": {
          "event": {
            "name": "task.open",
            "context": {
              "id": {
                "path": "/id"
              }
            }
          }
        },
        "progress": {
          "value": {
            "path": "/done"
          },
          "label": {
            "path": "/done_label"
          }
        }
      }
    },
    "label": "Tasks",
    "empty": {
      "component": "Status",
      "kind": "empty",
      "title": "No tasks found",
      "message": "You have no tasks scheduled for today."
    },
    "selection": "single",
    "selected": {
      "path": "/selected_id"
    }
  },
  "data": {
    "tasks": [
      {
        "id": "k1",
        "title": "Send Q3 invoice",
        "project": "Freelance",
        "priority": "high",
        "done": false
      },
      {
        "id": "k2",
        "title": "Book dentist",
        "project": "Personal",
        "priority": "normal",
        "done": false
      },
      {
        "id": "k3",
        "title": "Review Maya's draft",
        "project": "Website relaunch",
        "priority": "normal",
        "done": true
      }
    ]
  }
}
