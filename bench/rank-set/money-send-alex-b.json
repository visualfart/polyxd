{
  "specVersion": "0.1.0",
  "surface": {
    "id": "money_send",
    "title": "Send money",
    "intent": "money.send"
  },
  "root": {
    "component": "Confirm",
    "title": "Send payment to Alex Kim?",
    "message": "Are you sure you want to send £40 to Alex Kim for the concert tickets?",
    "consequence": "This payment will be sent and cannot be undone.",
    "summary": {
      "id": "draft",
      "component": "DetailList",
      "items": [
        {
          "key": "recipient",
          "label": "Recipient",
          "value": {
            "path": "/payees/id"
          }
        }
      ]
    },
    "severity": "consequential",
    "confirm": {
      "label": "Review payment",
      "action": {
        "event": {
          "name": "transfer.review",
          "context": {
            "recipient": {
              "path": "/draft/recipient"
            },
            "amount": {
              "path": "/draft/amount"
            },
            "reference": "Concert tickets"
          }
        }
      }
    },
    "cancel": {
      "label": "Cancel",
      "action": {
        "event": {
          "name": "ui.dismiss"
        }
      }
    }
  },
  "data": {
    "payees": [
      {
        "id": "p1",
        "name": "Alex Kim"
      },
      {
        "id": "p2",
        "name": "Sam Patel"
      },
      {
        "id": "p3",
        "name": "Landlord"
      }
    ],
    "draft": {
      "recipient": "p1",
      "amount": 40,
      "reference": "Concert tickets"
    },
    "limits": {
      "max": 5000,
      "currency": "GBP"
    }
  }
}
