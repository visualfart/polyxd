{
  "specVersion": "0.1.0",
  "surface": {
    "id": "money_budget_edit",
    "title": "Edit groceries budget",
    "intent": "money.budget.edit"
  },
  "root": {
    "component": "Section",
    "title": "Set your monthly groceries budget",
    "description": "Manage your spending limit and alerts for groceries.",
    "children": [
      {
        "component": "TextInput",
        "key": "category",
        "label": "Category",
        "value": {
          "path": "/budget/category"
        },
        "required": true
      },
      {
        "component": "TextInput",
        "key": "limit",
        "label": "New limit",
        "value": {
          "path": "/budget/limit"
        },
        "required": true
      },
      {
        "component": "Toggle",
        "key": "alerts_enabled",
        "label": "Alerts",
        "value": {
          "path": "/budget/alerts"
        },
        "description": "Receive warnings when you approach your spending limit",
        "action": {
          "event": {
            "name": "budget.setAlerts",
            "context": {
              "enabled": {
                "path": "/budget/alerts"
              }
            }
          }
        }
      },
      {
        "component": "Action",
        "label": "Set budget",
        "action": {
          "event": {
            "name": "budget.setLimit",
            "context": {
              "category": {
                "path": "/budget/category"
              },
              "limit": {
                "path": "/budget/limit"
              }
            }
          }
        },
        "emphasis": "primary"
      }
    ]
  },
  "data": {
    "budget": {
      "category": "groceries",
      "label": "Groceries",
      "limit": 300,
      "spent": 312.4,
      "currency": "GBP",
      "alerts": false
    }
  }
}
