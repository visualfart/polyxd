      "people": [
        "c1",
        "c2"
      ]
    },
    "slots": [
      {
        "start": "09:30",
        "label": "9:30–10:00"
      },
      {
        "start": "13:00",
        "label": "13:00–13:30"
      },
      {
        "start": "16:00",
        "label": "16:00–16:30"
      }
    ],
    "contacts": [
      {
        "id": "c1",
        "name": "Priya"
      },
      {
        "id": "c2",
        "name": "Tom"
      }
    ]
  }
}
