{
  "specVersion": "0.1.0",
  "surface": {
    "id": "calendar_schedule",
    "title": "Find availability",
    "intent": "calendar.schedule"
  },
  "root": {
    "component": "Section",
    "title": "Find availability",
    "description": "Please confirm the details for the meeting.",
    "children": [
      {
        "component": "Collection",
        "key": "available_slots",
        "items": {
          "path": "/slots",
          "item": {
            "component": "Card",
            "title": {
              "path": "/slots[*]/label"
            },
            "subtitle": {
              "path": "/slots[*]/start"
            },
            "children": [
              {
                "component": "Text",
                "text": "Available slots found."
              }
            ]
          }
        },
        "label": "Available timeslots",
        "empty": {
          "component": "Status",
          "kind": "empty",
          "title": "No slots found",
          "message": "Please check back later."
        }
      },
      {
        "component": "Group",
        "children": [
          {
            "component": "TextInput",
            "key": "date_str",
            "label": "Date",
            "value": {
              "path": "/draft/date"
            },
            "kind": "text",
            "required": true
          },
          {
            "component": "TextInput",
            "key": "attendee_str",
            "label": "Invitees",
            "value": {
              "path": "/draft/people"
            },
            "kind": "text",
            "required": true
          }
        ]
      }
    ]
  },
  "data": {
    "draft": {
      "date": "2026-09-22",
