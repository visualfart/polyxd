{
  "specVersion": "0.1.0",
  "surface": {
    "id": "calendar_schedule",
    "title": "Find availability",
    "intent": "calendar.schedule"
  },
  "root": {
    "component": "Section",
    "title": "Find availability",
    "description": "Select a time for the meeting with Tom and Priya.",
    "children": [
      {
        "component": "Collection",
        "key": "available_slots",
        "items": {
          "path": "/slots",
          "item": {
            "component": "Card",
            "title": "{label}",
            "subtitle": "Available slot",
            "children": [
              {
                "component": "Group",
                "children": [
                  {
                    "component": "Text",
                    "text": "Start time: {start}"
                  }
                ]
              }
            ]
          }
        },
        "label": "Available timeslots",
        "empty": {
          "id": "Status",
          "component": "Status",
          "kind": "info",
          "title": "No slots found",
          "message": "There are no available timeslots yet."
        }
      }
    ]
  },
  "data": {
    "slots": {
      "start": {
        "path": "/slots[*]/start"
      },
      "label": {
        "path": "/slots[*]/label"
      }
    }
  }
}
