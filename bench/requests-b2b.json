          "mine": 212,
          "pastdue": 31,
          "trials": 58
        },
        "view": "pastdue",
        "sort": {
          "column": "mrr",
          "direction": "descending"
        },
        "page": 1,
        "pageSize": 50,
        "selected": [],
        "accounts": [
          {
            "id": "a1",
            "name": "Acme Corp",
            "owner": "Rhea Mills",
            "plan": "Enterprise",
            "mrr": 4200,
            "seats": "48 / 50",
            "status": "Past due",
            "renews": "12 Oct 2026",
            "initials": "AC"
          },
          {
            "id": "a5",
            "name": "Hooli",
            "owner": "Jo Rivera",
            "plan": "Starter",
            "mrr": 120,
            "seats": "3 / 5",
            "status": "Trial",
            "renews": "27 Sep 2026",
            "initials": "HO"
          },
          {
            "id": "a2",
            "name": "Globex",
            "owner": "Tom Walsh",
            "plan": "Pro",
            "mrr": 1180,
            "seats": "22 / 25",
            "status": "Active",
            "renews": "3 Nov 2026",
            "initials": "GL"
          },
          {
            "id": "a3",
            "name": "Initech",
            "owner": "Rhea Mills",
            "plan": "Pro",
            "mrr": 940,
            "seats": "18 / 20",
            "status": "Active",
            "renews": "21 Oct 2026",
            "initials": "IN"
          }
        ]
      },
      "capabilities": [
        "accounts.sort",
        "accounts.page",
        "account.open",
        "accounts.remindStart",
        "accounts.export"
      ],
      "expect": {
        "components": [
          "Table"
        ],
        "capability": "account.open",
        "mustNot": [
          "accounts.remind",
          "Sending a reminder without a review step"
        ]
      },
      "task": {
        "instruction": "Open the Acme Corp account.",
        "steps": [
          {
            "press": "Acme Corp"
          }
        ],
        "expect": {
          "event": "account.open",
          "context": {
            "id": "a1"
          }
        }
      }
    },
    {
      "id": "b2b-account-open",
