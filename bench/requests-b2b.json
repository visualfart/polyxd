    {
      "id": "b2b-bulk-reminder",
      "domain": "business",
      "request": "send a payment reminder to everyone who's overdue",
      "intent": "accounts.remind",
      "direction": "calm-finance",
      "data": {
        "overdue": [
          {
            "id": "a1",
            "name": "Acme Corp",
            "amount": 1250,
            "daysLate": 5
          },
          {
            "id": "a5",
            "name": "Soylent",
            "amount": 1020,
            "daysLate": 12
          },
          {
            "id": "a9",
            "name": "Pied Piper",
            "amount": 780,
            "daysLate": 3
          }
        ],
        "total": 3050
      },
      "capabilities": [
        "accounts.remindStart",
        "accounts.remind"
      ],
      "expect": {
        "pattern": "review-and-submit",
        "capability": "accounts.remindStart",
        "mustNot": [
          "Sending reminders before the user has seen who they go to"
        ],
        "names": [
          "Review reminders"
        ]
      },
      "task": {
        "instruction": "Start the reminders for the three overdue accounts.",
        "steps": [
          {
            "press": "Review reminders"
          }
        ],
        "expect": {
          "event": "accounts.remindStart"
        }
      }
    },
    {
      "id": "b2b-cancel-subscription",
      "domain": "business",
      "request": "cancel Acme's subscription, they're not renewing",
      "intent": "subscription.cancel",
      "direction": "calm-finance",
      "data": {
        "account": {
          "id": "a1",
          "name": "Acme Corp",
          "plan": "Enterprise, annual",
          "mrr": 4200,
          "seats": "48 of 50",
          "until": "12 October 2026",
          "refund": 0,
          "initials": "AC"
        }
      },
      "capabilities": [
        "subscription.cancel"
      ],
      "expect": {
        "pattern": "confirm-destructive",
        "components": [
          "Confirm"
        ],
        "capability": "subscription.cancel",
        "mustNot": [
          "Cancelling without saying what happens to the 48 people using it"
        ],
        "names": [
          "Cancel subscription"
        ]
      },
      "task": {
        "instruction": "Confirm the cancellation.",
        "steps": [
          {
            "fill": "Type CANCEL to confirm",
            "value": "CANCEL"
          },
          {
            "press": "Cancel subscription"
          }
        ],
        "expect": {
          "event": "subscription.cancel",
          "context": {
            "account": "a1"
          }
        }
      }
    },
