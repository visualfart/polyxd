{
  "$schema": "../../packages/spec/schema/ui.schema.json",
  "specVersion": "0.1.0",
  "surface": {
    "id": "review",
    "title": "Check your booking",
    "intent": "travel.hotel.book",
    "pattern": "review-and-submit"
  },
  "root": "form",
  "components": [
    {
      "id": "form",
      "component": "Form",
      "children": [
        "terms"
      ],
      "submit": {
        "label": "Continue",
        "action": {
          "event": {
            "name": "hotel.book",
            "context": {
              "offerId": {
                "path": "/offer/id"
              },
              "acceptedTerms": {
                "path": "/draft/terms"
              }
            }
          }
        }
      }
    },
    {
      "id": "terms",
      "component": "Toggle",
      "key": "terms",
      "label": "I agree to the hotel's booking terms",
      "value": {
        "path": "/draft/terms"
      }
    }
  ],
  "data": {
    "guest": {
      "name": "Neel S",
      "email": "neel@example.com"
    },
    "offer": {
      "id": "o_3",
      "hotel": "Hotel Alfama",
      "dates": "3–6 Oct (3 nights)",
      "total": 312,
      "cancellation": "Free until 1 Oct"
    },
    "draft": {
      "terms": false
    }
  }
}
