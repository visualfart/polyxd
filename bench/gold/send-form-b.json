{
  "$schema": "../../packages/spec/schema/ui.schema.json",
  "specVersion": "0.1.0",
  "surface": {
    "id": "send",
    "title": "Send money",
    "intent": "money.send",
    "pattern": "multi-step-form"
  },
  "root": "form",
  "components": [
    {
      "id": "form",
      "component": "Form",
      "children": [
        "recipient",
        "amount",
        "reference",
        "fees"
      ],
      "submit": {
        "label": "Next",
        "action": {
          "event": {
            "name": "transfer.review",
            "context": {
              "recipient": {
                "path": "/draft/recipient"
              },
              "amount": {
                "path": "/draft/amount"
              },
              "reference": {
                "path": "/draft/reference"
              }
            }
          }
        }
      }
    },
    {
      "id": "recipient",
      "component": "Choice",
      "key": "recipient",
      "label": "Recipient",
      "options": {
        "path": "/payees",
        "valuePath": "id",
        "labelPath": "name"
      },
      "value": {
        "path": "/draft/recipient"
      },
      "required": true
    },
    {
      "id": "amount",
      "component": "TextInput",
      "key": "amount",
      "label": "How much?",
      "kind": "currency",
      "currency": "GBP",
      "value": {
        "path": "/draft/amount"
      },
      "required": true,
      "validation": {
        "min": 0.01,
        "max": 5000,
        "message": "Enter an amount between £0.01 and £5,000"
      }
    },
    {
      "id": "reference",
      "component": "TextInput",
      "key": "reference",
      "label": "Reference",
      "value": {
        "path": "/draft/reference"
      },
      "validation": {
        "maxLength": 18
      }
    },
    {
      "id": "fees",
      "component": "Disclosure",
      "summary": "Fees and timing",
      "children": [
        "fee-details"
      ]
    },
    {
      "id": "fee-details",
      "component": "DetailList",
      "items": [
        {
          "key": "fee",
          "label": "Fee",
          "value": {
            "path": "/quote/fee"
          },
          "format": {
            "type": "currency",
            "currency": "GBP"
          }
        },
        {
          "key": "arrives",
          "label": "Arrives",
          "value": {
            "path": "/quote/arrives"
          },
          "format": {
            "type": "relativeTime"
          }
        }
      ]
    }
  ],
  "data": {
    "payees": [
      {
        "id": "p1",
        "name": "Alex Kim"
      },
      {
        "id": "p2",
        "name": "Sam Patel"
      },
      {
        "id": "p3",
        "name": "Landlord"
      }
    ],
    "draft": {
      "recipient": null,
      "amount": null,
      "reference": ""
    },
    "quote": {
      "fee": 0,
      "arrives": "2026-09-19T12:05:00Z"
    }
  }
}
