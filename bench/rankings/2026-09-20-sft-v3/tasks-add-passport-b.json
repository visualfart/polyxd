{
  "specVersion": "0.1.0",
  "data": {
    "projects": [
      {
        "id": {}
      }
    ],
    "draft": {
      "title": {
        "path": "/draft/title"
      },
      "due": {
        "path": "/draft/due"
      },
      "priority": {
        "path": "/draft/priority"
      },
      "project": {
        "path": "/draft/project"
      }
    }
  },
  "root": "form",
  "components": [
    {
      "component": "Form",
      "children": [
        "title",
        "due",
        "priority",
        "project"
      ],
      "submit": {
        "label": "Add task",
        "action": {
          "event": {
            "name": "task.save",
            "context": {
              "title": {
                "path": "/draft/title"
              },
              "due": {
                "path": "/draft/due"
              },
              "priority": {
                "path": "/draft/priority"
              },
              "project": {
                "path": "/draft/project"
              }
            }
          }
        }
      },
      "cancel": {
        "label": "Cancel",
        "action": {
          "event": {
            "name": "ui.dismiss"
          }
        }
      },
      "id": "form"
    },
    {
      "component": "TextInput",
      "key": "title",
      "label": "Title",
      "value": {
        "path": "/draft/title"
      },
      "required": true,
      "id": "title"
    },
    {
      "component": "DateInput",
      "key": "due",
      "label": "Due",
      "value": {
        "path": "/draft/due"
      },
      "kind": "date",
      "required": true,
      "id": "due"
    },
    {
      "component": "Choice",
      "key": "priority",
      "label": "Priority",
      "options": [
        {
          "value": "high",
          "label": "High"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "low",
          "label": "Low"
        }
      ],
      "value": {
        "path": "/draft/priority"
      },
      "required": true,
      "id": "priority"
    },
    {
      "component": "TextInput",
      "key": "project",
      "label": "Project",
      "value": {
        "path": "/draft/project"
      },
      "required": true,
      "id": "project"
    }
  ],
  "surface": {
    "id": "add-task",
    "title": "New task",
    "intent": "tasks.create"
  }
}
