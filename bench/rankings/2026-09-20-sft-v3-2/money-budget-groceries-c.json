      "id": "category-input"
    },
    {
      "component": "RangeInput",
      "key": "limit_input",
      "label": "Monthly limit",
      "value": {
        "path": "/budget/limit"
      },
      "min": 0,
      "max": 1000,
      "step": 10,
      "format": {
        "type": "currency",
        "currency": "GBP"
      },
      "mode": "single",
      "id": "limit-input"
    },
    {
      "component": "Toggle",
      "key": "alerts_input",
      "label": "Alerts",
      "value": {
        "path": "/budget/alerts"
      },
      "description": "Receive warnings when you approach your budget limit.",
      "action": {
        "event": {
          "name": "budget.setAlerts",
          "context": {
            "enabled": true
          }
        }
      },
      "id": "alerts-input"
    }
