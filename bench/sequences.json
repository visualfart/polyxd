{
  "$comment": "Polyxd benchmark: multi-turn sequences. Each turn is a request with host data (\"same\" = the previous turn's data). keys is the semantic key vocabulary for the intent (given to the model, as interface memory would); stable keys must keep their component, relative order and label across turns (scored with compare() from @polyxd/verifier). See bench/README.md.",
  "sequences": [
    {
      "id": "seq-spending",
      "domain": "money",
      "intent": "money.spending.summary",
      "capabilities": [
        "transactions.open"
      ],
      "keys": {
        "spent": "Metric: amount spent this period",
        "budget": "Metric: budget or budget left",
        "by_category": "Chart: spending by category",
        "recent": "Collection: recent payments"
      },
      "turns": [
        {
          "request": "show my spending",
          "data": {
            "period": "September 2026",
            "spent": 1843.2,
            "budget": 2200,
            "byCategory": [
              {
                "category": "Rent",
                "amount": 950
              },
              {
                "category": "Groceries",
                "amount": 312.4
              },
              {
                "category": "Eating out",
                "amount": 221.8
              },
              {
                "category": "Transport",
                "amount": 148
              }
            ],
            "recent": [
              {
                "id": "t31",
                "merchant": "Tesco",
                "amount": -42.18
              },
              {
                "id": "t29",
                "merchant": "Dishoom",
                "amount": -63.5
              }
            ]
          }
        },
        {
          "request": "show my spending again",
          "data": "same"
        },
        {
          "request": "just groceries",
          "data": {
            "period": "September 2026",
            "category": "Groceries",
            "spent": 312.4,
            "budget": 350,
            "recent": [
              {
                "id": "t31",
                "merchant": "Tesco",
                "amount": -42.18
              },
              {
                "id": "t22",
                "merchant": "Lidl",
                "amount": -27.9
              }
            ]
          }
        },
        {
          "request": "how does that compare to last month?",
          "data": {
            "period": "August 2026",
            "category": "Groceries",
            "spent": 288.1,
            "budget": 350,
            "previous": 312.4
          }
        }
      ],
      "stable": [
        "spent",
        "budget"
      ],
      "mayChange": [
        "by_category disappears once filtered to one category",
        "recent narrows to groceries",
        "a comparison figure may be added in turn 4"
      ]
    },
